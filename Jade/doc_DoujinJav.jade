                                    td -
                                    td NO
                                    td +18 o no.
                                    td -
                                    td TRUE = +18 FALSE = Todo público

                                tr.filaAtributo
                                    td pixelizacion_grafico
                                    td BOOLEAN
                                    td -
                                    td NO
                                    td Censurado o no.
                                    td -
                                    td TRUE = Censurado FALSE = Sin censura

                                tr.filaAtributo
                                    td id_edicion
                                    td INT
                                    td FK
                                    td SI
                                    td Id de la expo que estamos vinculando.
